#!/bin/sh
# Local hook (0.323; turned on in 0.1033, D-100): runs .\scripts\Verify.ps1 before every push and stops the push when it fails.
# On the maintainer's PC it is on (git config core.hooksPath .githooks); a contributor turns it on once, from the repository root:
#   git config core.hooksPath .githooks          (off again: git config --unset core.hooksPath)
# 0.1112: when only tracked documents changed since that run, it runs the managed tests again (no build) before the push.
# No second build: Verify.ps1 runs here with no switch, so when the same sources already passed (its stamp artifacts/verify-stamp.json:
# version, SHA-256 of the files, Dalamud and SDK versions), as just after publish.sh or Verify.ps1 -Commit, it prints
# « SKIP checks » in a few seconds instead of building and testing again. Any change since that run builds and tests everything.
echo "pre-push: Verify.ps1 (skips when its stamp matches the same sources)"
# X-268 (0.1277): under publish.sh while the player is busy (TENSHO_NORELOAD=1), Verify.ps1 builds beside the game: no reload in a duty.
if command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -File ./scripts/Verify.ps1
else
  powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/Verify.ps1
fi
