<Project Sdk="Microsoft.NET.Sdk">
  <!-- X-120: the generic part of drawing a Dalamud plugin's windows without the game (moved out of src/TenshoAssistant.Desktop, X-119):
       where Dalamud and the game data are (DalamudPaths), the run-time resolution of Dalamud's assemblies and of cimgui.dll from the user's
       install (DalamudRuntime), the service stand-ins (StandIns), a headless ImGui context with fonts (ImGuiHeadless), the rewrite of
       UiBuilder's font statics in a temporary copy (Rewrite), the IL call graph (CallGraph) and the Win32 + OpenGL 1.1 window (Win32Gl).
       Used by src/TenshoAssistant.Desktop and tools/PluginUiTest/src/PluginUiTest. R05: nothing of Dalamud or of the game is copied:
       every Dalamud, Lumina, ImGui, HexaGen and Mono.Cecil reference is Private=false and resolved at run time. -->
  <PropertyGroup>
    <OutputType>Library</OutputType><TargetFramework>net10.0-windows</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><NoWarn>CA1416</NoWarn><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>PluginUiTest.Host</AssemblyName><RootNamespace>PluginUiTest.Host</RootNamespace>
    <DalamudLibPath Condition="'$(DalamudLibPath)' == '' and '$(DALAMUD_HOME)' != ''">$(DALAMUD_HOME)\</DalamudLibPath>
    <DalamudLibPath Condition="'$(DalamudLibPath)' == ''">$(APPDATA)\XIVLauncher\addon\Hooks\dev\</DalamudLibPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Lumina"><HintPath>$(DalamudLibPath)Lumina.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Lumina.Excel"><HintPath>$(DalamudLibPath)Lumina.Excel.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Dalamud"><HintPath>$(DalamudLibPath)Dalamud.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Dalamud.Bindings.ImGui"><HintPath>$(DalamudLibPath)Dalamud.Bindings.ImGui.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="HexaGen.Runtime"><HintPath>$(DalamudLibPath)HexaGen.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Mono.Cecil"><HintPath>$(DalamudLibPath)Mono.Cecil.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
