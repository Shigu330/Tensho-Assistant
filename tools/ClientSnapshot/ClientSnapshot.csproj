<Project Sdk="Microsoft.NET.Sdk">
  <!-- X-115: snapshot of the installed client's catalogues, without Dalamud running. It loads the built plugin (TenshoAssistant.dll) and
       runs its own catalogue loaders on a Lumina GameData, so the files it writes have exactly the plugin cache's shape. -->
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup>
  <ItemGroup>
    <Reference Include="Lumina"><HintPath>$(APPDATA)/XIVLauncher/addon/Hooks/dev/Lumina.dll</HintPath></Reference>
    <Reference Include="Lumina.Excel"><HintPath>$(APPDATA)/XIVLauncher/addon/Hooks/dev/Lumina.Excel.dll</HintPath></Reference>
    <Reference Include="Dalamud"><HintPath>$(APPDATA)/XIVLauncher/addon/Hooks/dev/Dalamud.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
