<Project Sdk="Microsoft.NET.Sdk">
  <!-- X-118 (plan 4, step 0): can the plugin's own ImGui pages run in a desktop window, without Dalamud and without the game running?
       It loads the built plugin (TenshoAssistant.dll) and Dalamud's ImGui bindings (Dalamud.Bindings.ImGui + cimgui.dll) from the
       installed Dalamud, opens a plain Win32 window rendered with OpenGL 1.1 (opengl32.dll, part of Windows: no package to download),
       feeds the page's services from Lumina through stand-ins (as tools/ClientSnapshot) and draws the real page. Nothing is copied
       into the repository: the Dalamud and game files are read where they are installed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><NoWarn>CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Lumina"><HintPath>$(APPDATA)/XIVLauncher/addon/Hooks/dev/Lumina.dll</HintPath></Reference>
    <Reference Include="Lumina.Excel"><HintPath>$(APPDATA)/XIVLauncher/addon/Hooks/dev/Lumina.Excel.dll</HintPath></Reference>
    <Reference Include="Dalamud"><HintPath>$(APPDATA)/XIVLauncher/addon/Hooks/dev/Dalamud.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Dalamud.Bindings.ImGui"><HintPath>$(APPDATA)/XIVLauncher/addon/Hooks/dev/Dalamud.Bindings.ImGui.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="HexaGen.Runtime"><HintPath>$(APPDATA)/XIVLauncher/addon/Hooks/dev/HexaGen.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Mono.Cecil"><HintPath>$(APPDATA)/XIVLauncher/addon/Hooks/dev/Mono.Cecil.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Reflection.MetadataLoadContext"><HintPath>$(APPDATA)/XIVLauncher/addon/Hooks/dev/System.Reflection.MetadataLoadContext.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
