    <Compile Include="../../src/TenshoAssistant/Inventory/*.cs" Exclude="../../src/TenshoAssistant/Inventory/*.Dalamud.cs" Link="Inventory/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
