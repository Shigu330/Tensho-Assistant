# 0.323: editor defaults matching the files as they are (no style rule is enforced: the code mixes « if( » and « if ( »).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{yml,yaml,json,csproj,props,targets}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Windows PowerShell 5.1 needs the BOM to read non-ASCII characters in scripts.
[*.ps1]
charset = utf-8-bom

[*.{bat,cmd}]
end_of_line = crlf

# X-816 (0.1883): a private member never used or never read (IDE0051, IDE0052) and an unused parameter (IDE0060) stop the Release
# build of the plugin and the tests (EnforceCodeStyleInBuild in their csproj); a signature imposed by its caller names the parameter _ .
[{src/TenshoAssistant,tests/TenshoAssistant.Tests}/**.cs]
dotnet_diagnostic.IDE0051.severity = error
dotnet_diagnostic.IDE0052.severity = error
dotnet_diagnostic.IDE0060.severity = error
