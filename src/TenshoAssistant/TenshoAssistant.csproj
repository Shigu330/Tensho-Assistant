<Project Sdk="Dalamud.NET.Sdk">
  <PropertyGroup>
    <Version>0.1212.0</Version>
    <AssemblyName>TenshoAssistant</AssemblyName>
    <RootNamespace>TenshoAssistant</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PlatformTarget>x64</PlatformTarget>
    <!-- 0.465 (A-03, DEC-028): Raphael.Net brings a native solver: its win-x64 library goes next to the DLL, as in Craftimizer. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <OutputPath>$(MSBuildProjectDirectory)\bin\x64\$(Configuration)\</OutputPath>
    <!-- X-126 (D-137): the desktop app installed from Settings › Advanced. A build for the official repository would pass
         -p:TenshoDesktopInstall=false: no installer, the section only links to the release page. -->
    <TenshoDesktopInstall Condition="'$(TenshoDesktopInstall)' == ''">true</TenshoDesktopInstall>
    <DefineConstants Condition="'$(TenshoDesktopInstall)' != 'true'">$(DefineConstants);TENSHO_NO_DESKTOP_INSTALL</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Raphael.Net" Version="5.0.0" />
    <!-- X-172 (0.1136, trial docs/evidence/x172-sqlite-trial.md): the discoveries in SQLite (Discoveries/DiscoveryDatabase.cs). The bundle brings the
         native e_sqlite3.dll, next to the DLL like Raphael's; set above the 2.1.13 Microsoft.Data.Sqlite asks for: NuGet flags lib.e_sqlite3 up to
         2.1.11 as vulnerable (GHSA-2m69-gcr7-jv3q). -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.14" />
  </ItemGroup>
  <ItemGroup>
    <!-- X-126 (0.1113): the desktop app's release rules and install, one source shared with the app (src/TenshoAssistant.Desktop). -->
    <Compile Include="..\TenshoAssistant.Desktop\DesktopUpdate.cs;..\TenshoAssistant.Desktop\DesktopVersionCheck.cs;..\TenshoAssistant.Desktop\DesktopInstall.cs;..\TenshoAssistant.Desktop\DesktopPages.cs" Link="Desktop\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- 0.248: languages live only inside the DLL (embedded); an optional Localization/Languages folder still overrides them. -->
    <EmbeddedResource Include="Localization\Languages\*.json" />
    <EmbeddedResource Include="FreeCompany\Data\submarine-loot.json" />
    <EmbeddedResource Include="FreeCompany\Data\submarine-breakpoints.csv" />
    <EmbeddedResource Include="FreeCompany\Data\airship-unlock.csv" />
    <EmbeddedResource Include="FreeCompany\Data\airship-drop.csv" />
    <EmbeddedResource Include="Events\Data\festival-names.csv" />
    <EmbeddedResource Include="Reminders\Data\garden-seeds.csv" />
    <EmbeddedResource Include="Reminders\Data\garden-crosses.csv" />
    <!-- Plugin icon shown by Dalamud (images/icon.png next to the DLL); generated with AI, declared in the manifest description. -->
    <None Include="images\icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
